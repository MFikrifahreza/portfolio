# 🔐 ENVIRONMENT CONFIGURATION - LOCAL DEVELOPMENT
# 
# Copy file ini ke .env untuk setup proyek lokal
# File .env ini TIDAK boleh di-commit ke git (sudah di .gitignore)
#
# Untuk production, atur di platform hosting (Vercel, Netlify, dll)

# ========================================
# API Configuration
# ========================================

# GEMINI API KEY (Google AI)
# - Kosongkan jika tidak punya
# - Dapatkan dari: https://makersuite.google.com/app/apikey
# - Format: "AIzaSy..." atau "AQ.Ab8RN..."
GEMINI_API_KEY=""

# ========================================
# Application URLs
# ========================================

# URL aplikasi - digunakan untuk links & redirects
# Development: http://localhost:3000
# Production: https://your-domain.com
APP_URL="http://localhost:3000"

# ========================================
# Optional - Development Settings
# ========================================

# Disable Hot Module Replacement (HMR) saat editing
# Set ke 'true' hanya jika ada issue dengan file watching
# DISABLE_HMR=false

# API Base URL untuk backend (jika ada)
# VITE_API_BASE="http://localhost:3000/api"

# Enable/Disable analytics tracking
# VITE_ENABLE_ANALYTICS=true

# ========================================
# CATATAN PENTING
# ========================================
# 
# 1. Jangan share file ini dengan orang lain
# 2. Jangan commit ke git repository
# 3. Untuk production, setup variables di:
#    - Vercel: Project Settings > Environment Variables
#    - Netlify: Site Settings > Build & Deploy > Environment
#    - Server: Set via environment sebelum run application
#
# 4. Untuk development:
#    - Copy file ini ke .env
#    - Edit sesuai kebutuhan lokal
#    - Simpan & restart npm run dev
#
# ========================================
